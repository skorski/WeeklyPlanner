{# --- SECTION DIVIDER: Family Corner --- #}
{% if parenting_data %}
<div class="page page-divider" data-section-id="family_parenting" data-section-instance="divider">
  <div class="divider-title">Family Corner</div>
  <div class="divider-rule"></div>
  <div class="divider-sub">Conversation starters, parenting nudges, and connection ideas</div>
  <div class="page-folio">{{ ns.pg }}{% set ns.pg = ns.pg + 1 %}</div>
</div>
{% endif %}

{# --- PARENTING CORNER (split across pages to avoid overflow) --- #}
{% if parenting_data %}
{% set questions = parenting_data.dinner_questions | default([]) %}
{% set q_split = (questions | length + 1) // 2 %}

{# Page 1: Theme + first half of dinner questions #}
<div class="page page-parenting" data-section-id="family_parenting" data-section-instance="questions-1" data-source-path="parenting_data.dinner_questions" data-fit="bounded">
  <div class="page-header">Family Corner</div>
  <h2 class="section-header">Parenting Corner</h2>
  {% if parenting_data.weekly_theme %}
  <div class="theme-banner">
    <h3>{{ parenting_data.weekly_theme.title }}</h3>
    <p>{{ parenting_data.weekly_theme.description }}</p>
  </div>
  {% endif %}

  {% if questions %}
  <h3 class="subsection-label">Dinner Conversation Starters</h3>
  {% for q in questions[:q_split] %}
  <div class="question-entry">
    <div class="question-day">{{ q.day }} — {{ q.dinner | default("") }}</div>
    <div class="question-text">"{{ q.question }}"</div>
    <div class="question-why">{{ q.why }}</div>
  </div>
  {% endfor %}
  {% endif %}
  <div class="page-folio">{{ ns.pg }}{% set ns.pg = ns.pg + 1 %}</div>
</div>

{# Page 2: remaining dinner questions #}
<div class="page page-parenting" data-section-id="family_parenting" data-section-instance="questions-2" data-source-path="parenting_data.dinner_questions" data-fit="bounded">
  <div class="page-header">Family Corner</div>
  <h2 class="section-header">Conversation Starters (continued)</h2>
  {% for q in questions[q_split:] %}
  <div class="question-entry">
    <div class="question-day">{{ q.day }} — {{ q.dinner | default("") }}</div>
    <div class="question-text">"{{ q.question }}"</div>
    <div class="question-why">{{ q.why }}</div>
  </div>
  {% endfor %}
  <div class="page-folio">{{ ns.pg }}{% set ns.pg = ns.pg + 1 %}</div>
</div>

{# Nudge pages: one substantive nudge per page #}
{% set nudges = parenting_data.nudges | default([]) %}
{% for n in nudges %}
<div class="page page-parenting" data-section-id="family_parenting" data-section-instance="nudge-{{ loop.index }}" data-source-path="parenting_data.nudges[{{ loop.index0 }}]" data-fit="bounded">
  <div class="page-header">Family Corner</div>
  <h2 class="section-header">{% if loop.first %}Nudges{% else %}Nudges (continued){% endif %}</h2>
  <div class="nudge-card">
    <h4>{{ n.title }}</h4>
    <p><em>{{ n.context }}</em></p>
    <p>{{ n.suggestion }}</p>
    {% if n.how_to %}
    <ol class="nudge-steps">{% for step in n.how_to %}<li>{{ step }}</li>{% endfor %}</ol>
    {% endif %}
  </div>
  <div class="page-folio">{{ ns.pg }}{% set ns.pg = ns.pg + 1 %}</div>
</div>
{% endfor %}

{# Page 5: Connection Ritual + Book Rec #}
<div class="page page-parenting" data-section-id="family_parenting" data-section-instance="connection" data-source-path="parenting_data.connection_ritual" data-fit="bounded">
  <div class="page-header">Family Corner</div>
  <h2 class="section-header">Connection & Reading</h2>

  {% if parenting_data.connection_ritual %}
  <div class="connection-ritual">
    <h4>{{ parenting_data.connection_ritual.title }}</h4>
    <p>{{ parenting_data.connection_ritual.description }}</p>
    {% if parenting_data.connection_ritual.when %}
    <p class="ritual-meta"><strong>When:</strong> {{ parenting_data.connection_ritual.when }}{% if parenting_data.connection_ritual.duration %} · {{ parenting_data.connection_ritual.duration }}{% endif %}</p>
    {% endif %}
  </div>
  {% endif %}

  {% if parenting_data.recommendation %}
  <div class="book-rec">
    <h4>📖 {{ parenting_data.recommendation.title }}{% if parenting_data.recommendation.author %} by {{ parenting_data.recommendation.author }}{% endif %}</h4>
    <p>{{ parenting_data.recommendation.why }}</p>
    <p><em>{{ parenting_data.recommendation.connection }}</em></p>
  </div>
  {% endif %}

  <div class="page-folio">{{ ns.pg }}{% set ns.pg = ns.pg + 1 %}</div>
</div>

{# Page 6: Parent Reflection #}
<div class="page page-parenting" data-section-id="family_parenting" data-section-instance="reflection" data-source-path="parenting_data.parent_reflection" data-fit="bounded">
  <div class="page-header">Family Corner</div>
  <h2 class="section-header">Reflection</h2>

  {% if parenting_data.parent_reflection %}
  <div class="reflection-box">
    {{ parenting_data.parent_reflection }}
  </div>
  {% endif %}

  <p class="present-parent-note">You don't need to be a perfect parent — just a present one.</p>
  <div class="page-folio">{{ ns.pg }}{% set ns.pg = ns.pg + 1 %}</div>
</div>
{% endif %}

{# --- STOIC GUIDE (multi-page spread) --- #}
{% if stoic_data %}
{# Page 1: Theme + Anchor Quote + Introduction #}
<div class="page page-stoic" data-section-id="stoic_guide" data-section-instance="intro" data-source-path="stoic_data" data-fit="bounded">
  <div class="page-header">Family Corner</div>
  <h2 class="section-header">The Stoic Guide</h2>
  <div class="stoic-theme-banner">
    <div class="stoic-category">{{ stoic_data.theme.category | default("") }}</div>
    <h3>{{ stoic_data.theme.title }}</h3>
    <p>{{ stoic_data.theme.description }}</p>
  </div>

  <div class="anchor-quote">
    "{{ stoic_data.anchor_quote.text }}"
    <span class="quote-source">— {{ stoic_data.anchor_quote.source }}, <em>{{ stoic_data.anchor_quote.work }}</em> {{ stoic_data.anchor_quote.reference }}</span>
  </div>

  <div class="stoic-intro">{{ stoic_data.introduction }}</div>

  {% for m in stoic_data.meditations[:1] %}
  <div class="meditation-entry">
    {% if m.day %}<span class="meditation-day">{{ m.day }}</span>{% endif %}
    <span class="meditation-title">{{ m.title }}</span>
    <div class="meditation-reflection">{{ m.reflection }}</div>
    <div class="meditation-prompt">{{ m.prompt }}</div>
    {% if m.secondary_quote %}
    <div class="meditation-secondary-quote">"{{ m.secondary_quote.text }}" — {{ m.secondary_quote.source }}</div>
    {% endif %}
  </div>
  {% endfor %}
  <div class="page-folio">{{ ns.pg }}{% set ns.pg = ns.pg + 1 %}</div>
</div>

{# Meditation pages: 2-3 meditations per page #}
{% set med_per_page = 3 %}
{% set remaining = stoic_data.meditations[1:] %}
{% set total_med_pages = (remaining | length + med_per_page - 1) // med_per_page %}
{% for page_num in range(total_med_pages) %}
{% set start = page_num * med_per_page %}
{% set end = [start + med_per_page, remaining | length] | min %}
{% set is_last_med_page = (page_num == total_med_pages - 1) %}
<div class="page page-stoic" data-section-id="stoic_guide" data-section-instance="meditations-{{ page_num + 1 }}" data-source-path="stoic_data.meditations" data-fit="bounded">
  <div class="page-header">Family Corner</div>
  <h2 class="section-header">Reflections & Practice</h2>

  {% for m in remaining[start:end] %}
  <div class="meditation-entry">
    {% if m.day %}<span class="meditation-day">{{ m.day }}</span>{% endif %}
    <span class="meditation-title">{{ m.title }}</span>
    <div class="meditation-reflection">{{ m.reflection }}</div>
    <div class="meditation-prompt">{{ m.prompt }}</div>
    {% if m.secondary_quote %}
    <div class="meditation-secondary-quote">"{{ m.secondary_quote.text }}" — {{ m.secondary_quote.source }}</div>
    {% endif %}
  </div>
  {% endfor %}
  <div class="page-folio">{{ ns.pg }}{% set ns.pg = ns.pg + 1 %}</div>
</div>
{% endfor %}

{# Final page: Family Exercise + Young Stoic + Closing #}
{% if stoic_data.family_exercise or stoic_data.young_stoic or stoic_data.closing_thought %}
<div class="page page-stoic" data-section-id="stoic_guide" data-section-instance="practice" data-source-path="stoic_data.family_exercise" data-fit="bounded">
  <div class="page-header">Family Corner</div>
  <h2 class="section-header">Practice Together</h2>

  {% if stoic_data.family_exercise %}
  <div class="stoic-exercise">
    <h4>{{ stoic_data.family_exercise.title }}</h4>
    <p>{{ stoic_data.family_exercise.description }}</p>
    <p><em>{{ stoic_data.family_exercise.connection }}</em></p>
  </div>
  {% endif %}

  {% if stoic_data.young_stoic %}
  <div class="young-stoic">
    <h4>{{ stoic_data.young_stoic.title }}</h4>
    <p>{{ stoic_data.young_stoic.prompt }}</p>
    <p><em>{{ stoic_data.young_stoic.lesson }}</em></p>
  </div>
  {% endif %}

  {% if stoic_data.closing_thought %}
  <div class="closing-thought">{{ stoic_data.closing_thought }}</div>
  {% endif %}

  <div class="page-folio">{{ ns.pg }}{% set ns.pg = ns.pg + 1 %}</div>
</div>
{% endif %}
{% endif %}
