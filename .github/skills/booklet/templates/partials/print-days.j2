{# --- SECTION DIVIDER: Daily Plan --- #}
<div class="page page-divider">
  <div class="divider-title">Daily Plan</div>
  <div class="divider-rule"></div>
  <div class="divider-sub">{{ daily_plan_subtitle | default("Seven days of dinner, music, and good company") }}</div>
  <div class="page-folio">3</div>
</div>

{# --- DAILY PAGES (three-page spread per day) --- #}
{% for day in days %}
{# Page 1: The Day — weather, calendar, dinner, Mamma Karen, Variations #}
<div class="page page-day page-day-left">
  <div class="page-header">Daily Plan</div>
  {% if day.weather %}
  <div class="weather-line">{{ weather_oneliner_print(day, days) }}</div>
  {% endif %}
  <h2 class="section-header">{{ day.long_name }}</h2>

  {% if day.parsed_engagements %}
  <div class="calendar-block">
    {% for e in day.parsed_engagements %}
    <div class="engagement-row">
      <span class="engagement-time">{{ e.time }}</span>
      <span class="engagement-rule"></span>
      <span class="engagement-event">{{ e.event }}</span>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {% if day.day_intro %}
  <div class="day-intro">{{ day.day_intro }}</div>
  {% endif %}

  {% if day.dinner %}
  <div class="dinner-block">
    <div class="dinner-name">{{ day.dinner }}</div>
    {% if day.dinner_cuisine %}<div class="cuisine-label">{{ day.dinner_cuisine }}</div>{% endif %}
    {% if day.dinner_description %}<div class="dinner-desc">{{ day.dinner_description }}</div>{% endif %}
    {% if day.dinner_key_ingredients %}
    <div class="ingredients-line">{{ day.dinner_key_ingredients | join(", ") }}</div>
    {% endif %}
    {% if day.dinner_notes %}<div class="notes-line">{{ day.dinner_notes }}</div>{% endif %}
    {% if day.elsie_note %}<div class="elsie-note">🧒 {{ day.elsie_note }}</div>{% endif %}
  </div>
  {% endif %}

  {# Mamma Karen + Variations flow directly under the dinner #}
  {% if day.recipe_card %}
  <div class="recipe-inline-block">
    {% if day.recipe_card.source_url %}
    <div class="recipe-source-line"><a href="{{ day.recipe_card.source_url }}">{{ day.recipe_card.source_name | default("View recipe") }}</a>{% if day.recipe_card.servings %} · {{ day.recipe_card.servings }} servings{% endif %}{% if day.recipe_card.prep_time %} · Prep {{ day.recipe_card.prep_time }}{% endif %}{% if day.recipe_card.cook_time %} · Cook {{ day.recipe_card.cook_time }}{% endif %}</div>
    {% endif %}

    {% if day.recipe_card.nonna_says %}
    <div class="nonna-block">
      <h4>Mamma Karen Says</h4>
      <blockquote class="nonna-quote">{{ day.recipe_card.nonna_says }}</blockquote>
    </div>
    {% endif %}

    {% if day.recipe_card.variations %}
    <div class="variations-block">
      <h4>Variations</h4>
      {% for v in day.recipe_card.variations %}
      <div class="variation-item"><strong>{{ v.name }}</strong> — {{ v.twist }}{% if v.source_url %} <a href="{{ v.source_url }}" class="variation-link">(recipe)</a>{% endif %}</div>
      {% endfor %}
    </div>
    {% endif %}
  </div>
  {% endif %}

  {% if day.dinner_question %}
  <div class="conversation-block">
    <h4>At the Table</h4>
    <div class="conversation-question">{{ day.dinner_question.question }}</div>
    {% if day.dinner_question.why %}<div class="conversation-why">{{ day.dinner_question.why }}</div>{% endif %}
  </div>
  {% endif %}

  <div class="page-folio">{{ 4 + (loop.index0 * 3) }}</div>
</div>

{# Page 2: Principles — daily reading #}
<div class="page page-day page-day-principles">
  <div class="page-header">{{ day.long_name }} · Principles</div>

  {% if principles_data and principles_data.daily_entries %}
  {% set principle = principles_data.daily_entries[loop.index0] %}
  {% if principle %}
  <div class="principles-block">
    {% if loop.index0 == 0 and principles_data.theme %}
    <div class="principles-theme-banner">
      <span class="principles-category">{{ principles_data.theme.category | default("") }}</span>
      <div class="principles-theme-title">{{ principles_data.theme.title }}</div>
      {% if principles_data.theme.description %}<div class="principles-theme-desc">{{ principles_data.theme.description }}</div>{% endif %}
    </div>
    {% if principles_data.anchor_quote %}
    <blockquote class="principles-anchor-quote">
      "{{ principles_data.anchor_quote.text }}"
      <cite>— {{ principles_data.anchor_quote.source }}{% if principles_data.anchor_quote.work %}, <em>{{ principles_data.anchor_quote.work }}</em>{% endif %}{% if principles_data.anchor_quote.reference %} {{ principles_data.anchor_quote.reference }}{% endif %}</cite>
    </blockquote>
    {% endif %}
    {% endif %}

    <h3 class="principles-entry-title">{{ principle.title }}</h3>
    <div class="principles-essay">{% for para in principle.essay.split('\n\n') %}<p>{{ para }}</p>{% endfor %}</div>

    {% if principle.source_quote %}
    <blockquote class="principles-quote">
      "{{ principle.source_quote.text }}"
      <cite>— {{ principle.source_quote.source }}</cite>
    </blockquote>
    {% endif %}

    {% if principle.reflection_prompt %}
    <div class="principles-reflect"><strong>Reflect:</strong> {{ principle.reflection_prompt }}</div>
    {% endif %}

    {% if loop.last and principles_data.closing_line %}
    <div class="principles-closing">{{ principles_data.closing_line }}</div>
    {% endif %}
  </div>
  {% endif %}
  {% else %}
  <div class="principles-block principles-empty">
    <p class="empty-note">Principles content not yet generated for this week.</p>
  </div>
  {% endif %}

  <div class="page-folio">{{ 5 + (loop.index0 * 3) }}</div>
</div>

{# Page 3: Chef's Tips + Album #}
<div class="page page-day page-day-right">
  <div class="page-header">{{ day.long_name }}</div>

  {% if day.dinner_elevation_tips %}
  <div class="elevation-block">
    <h4>Chef's Tips</h4>
    {% for tip in day.dinner_elevation_tips %}
    <div class="elevation-tip">
      <span class="tip-label">{{ tip.type }}</span> <strong>{{ tip.title }}</strong> — {{ tip.instruction }}
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {% if day.album %}
  <div class="album-block">
    <div class="album-anchor-rule"></div>
    {% if day.album_artist %}<div class="album-artist">{{ day.album_artist }}</div>{% endif %}
    <div class="album-title">{{ day.album_title | default(day.album) }}</div>
    <div class="album-info">{{ day.album_year | default("") }} · {{ day.album_genre | default("") }} · {{ day.album_mood | default("") }}</div>
    {% if day.album_description %}<div class="album-desc">{{ day.album_description | truncate(150, true, '…') }}</div>{% endif %}
    {% if day.album_pairing_rationale %}<div class="album-why">{{ day.album_pairing_rationale }}</div>{% endif %}
    {% if day.album_lyrical_story %}<div class="album-story">{{ day.album_lyrical_story }}</div>{% endif %}
    {% if day.album_spotify_url %}<a href="{{ day.album_spotify_url }}" class="spotify-link" target="_blank" rel="noopener">Listen on Spotify</a>{% endif %}
  </div>
  {% endif %}

  <div class="page-folio">{{ 6 + (loop.index0 * 3) }}</div>
</div>
{% endfor %}
