{# --- SECTION DIVIDER: The Weekly Read --- #}
{% if newsletter_data and newsletter_data.clusters %}
<div class="page page-divider">
  <div class="divider-title">The Weekly Read</div>
  <div class="divider-rule"></div>
  <div class="divider-sub">{{ newsletter_data.total_articles | default(0) }} articles clipped · Themes, reflections, and something fun</div>
  <div class="page-folio">{{ ns.pg }}{% set ns.pg = ns.pg + 1 %}</div>
</div>

{# --- NEWSLETTER PAGES: one page per cluster --- #}
{% for cluster in newsletter_data.clusters %}
<div class="page page-newsletter">
  <div class="page-header">The Weekly Read</div>

  <h3 class="cluster-theme">{{ cluster.theme }}</h3>
  <div class="cluster-synthesis">{{ cluster.synthesis }}</div>
  <ul class="article-list">
  {% for article in cluster.articles %}
    <li>
      <span class="article-title">{{ article.title }}</span>
      {% if article.tags %}<span class="article-tags">({{ article.tags | join(', ') }})</span>{% endif %}
      {% if article.one_liner %}<span class="article-oneliner">{{ article.one_liner }}</span>{% endif %}
    </li>
  {% endfor %}
  </ul>

  <div class="page-folio">{{ ns.pg }}{% set ns.pg = ns.pg + 1 %}</div>
</div>
{% endfor %}

{# --- NEWSLETTER CLOSING PAGE: reflections + fun --- #}
{% if newsletter_data.reflections or newsletter_data.fun_section %}
<div class="page page-newsletter">
  <div class="page-header">The Weekly Read</div>

{% if newsletter_data.reflections %}
  <div class="through-line">
    <strong>The Through-Line:</strong> {{ newsletter_data.reflections }}
  </div>
{% endif %}

{% if newsletter_data.fun_section %}
  <div class="fun-section">
    <h3>{{ newsletter_data.fun_section.title | default("And Finally…") }}</h3>
    <p>{{ newsletter_data.fun_section.content }}</p>
    {% if newsletter_data.fun_section.source_url %}
    <p class="fun-source">Source: <a href="{{ newsletter_data.fun_section.source_url }}">{{ newsletter_data.fun_section.source_name | default("Link") }}</a></p>
    {% endif %}
  </div>
{% endif %}

  <p class="newsletter-footer">{{ newsletter_data.total_articles | default(0) }} articles · {{ newsletter_data.week_range | default(week_range) }}</p>
  <div class="page-folio">{{ ns.pg }}{% set ns.pg = ns.pg + 1 %}</div>
</div>
{% endif %}
{% endif %}

{# --- EXTRA SECTIONS (extensible, non-parenting) --- #}
{% if extra_sections %}
{% for section in extra_sections %}
{% if "Parenting" not in section.title %}
<div class="page page-extra">
  <div class="page-header">Extras</div>
  <h2 class="section-header">{{ section.title }}</h2>
  <div class="extra-content">{{ section.content }}</div>
  <div class="page-folio">{{ ns.pg }}{% set ns.pg = ns.pg + 1 %}</div>
</div>
{% endif %}
{% endfor %}
{% endif %}

{# --- BEDTIME STORY (multi-page) --- #}
{% if child_wisdom %}
<div class="page page-divider">
  <div class="divider-title">Bedtime Story</div>
  <div class="divider-rule"></div>
  <div class="divider-sub">{{ child_wisdom.title }}</div>
  <div class="page-folio">{{ ns.pg }}{% set ns.pg = ns.pg + 1 %}</div>
</div>

{% set paragraphs = child_wisdom.story.split('\n\n') %}
{% set ns_story = namespace(page_paras=[]) %}
{% for para in paragraphs %}
{% if para.strip() %}
{% set ns_story.page_paras = ns_story.page_paras + [para.strip()] %}
{% endif %}
{% endfor %}

{# Render story pages — estimate paragraph heights by character count to fill A5 pages.
   Measured: dialog lines (~20 chars) = 18px, medium (~100 chars) = 36px, long (~200 chars) = 54-72px.
   At 8.5pt justified on A5: ~70 usable chars per line, 18px per line.
   Usable height ~660px. Title ~50px on page 1. Target ~85% fill. #}
{% set ns_page = namespace(pages=[], current=[], current_h=0) %}
{% set PAGE_BUDGET = 640 %}
{% set TITLE_COST = 55 %}
{% set PROMPT_COST = 35 %}
{% set LINE_H = 18 %}

{% for para in ns_story.page_paras %}
{# Estimate height: ~70 chars per line at 8.5pt justified on A5 #}
{% set lines = ((para | length) // 70) + 1 %}
{% set para_h = lines * LINE_H %}
{% set is_first_page = (ns_page.pages | length == 0 and ns_page.current | length == 0) %}
{% set budget = PAGE_BUDGET - (TITLE_COST if is_first_page else 0) %}

{% if ns_page.current_h + para_h > budget and ns_page.current | length > 0 %}
{# Page full — start new page #}
{% set ns_page.pages = ns_page.pages + [ns_page.current] %}
{% set ns_page.current = [para] %}
{% set ns_page.current_h = para_h %}
{% else %}
{% set ns_page.current = ns_page.current + [para] %}
{% set ns_page.current_h = ns_page.current_h + para_h %}
{% endif %}
{% endfor %}

{# Flush last page #}
{% if ns_page.current | length > 0 %}
{% set ns_page.pages = ns_page.pages + [ns_page.current] %}
{% endif %}

{# If the last page is very short (< 4 paragraphs), merge it into the previous page #}
{% if ns_page.pages | length > 1 and ns_page.pages[-1] | length < 4 %}
{% set merged = ns_page.pages[-2] + ns_page.pages[-1] %}
{% set ns_page.pages = ns_page.pages[:-2] + [merged] %}
{% endif %}

{% set total_pages = ns_page.pages | length %}
{% for page_paras in ns_page.pages %}
<div class="page page-story{% if loop.index0 == 0 %} page-story-first{% endif %}">
  <div class="page-header">Bedtime Story</div>
  {% if loop.index0 == 0 %}
  <h3 class="story-title">{{ child_wisdom.title }}</h3>
  {% endif %}
  <div class="story-text">
    {% for para in page_paras %}
    <p>{{ para }}</p>
    {% endfor %}
  </div>
  {% if loop.last and child_wisdom.discussion_prompt %}
  <div class="story-prompt">{{ child_wisdom.discussion_prompt }}</div>
  {% endif %}
  <div class="page-folio">{{ ns.pg }}{% set ns.pg = ns.pg + 1 %}</div>
</div>
{% endfor %}
{% endif %}

{# --- BACK COVER --- #}
<div class="page page-back">
  <div class="back-inner">
  <div class="back-divider"></div>
  <div class="colophon">{{ week_range }} · Generated {{ generated_at }}</div>
  </div>
</div>