{# --- SECTION DIVIDER: The Weekly Read --- #}
{% if newsletter_data and newsletter_data.clusters %}
<div class="page page-divider" data-section-id="weekly_read" data-section-instance="divider">
  <div class="divider-title">The Weekly Read</div>
  <div class="divider-rule"></div>
  <div class="divider-sub">{{ newsletter_data.total_articles | default(0) }} articles clipped · Themes, reflections, and something fun</div>
  <div class="page-folio">{{ ns.pg }}{% set ns.pg = ns.pg + 1 %}</div>
</div>

{# --- NEWSLETTER PAGES: paginated per cluster --- #}
{% set NL_PAGE_BUDGET = 600 %}
{% set NL_LINE_H = 16 %}
{% set NL_CHARS_PER_LINE = 72 %}
{% set NL_THEME_COST = 40 %}
{% set NL_ARTICLE_COST = 60 %}
{% for cluster in newsletter_data.clusters %}
{% set syn_paragraphs = (cluster.synthesis or "").split('\n\n') if cluster.synthesis else [] %}
{% set ns_nl = namespace(pages=[], current=[], current_h=NL_THEME_COST) %}
{% for para in syn_paragraphs %}
{% set p = para.strip() %}
{% if p %}
{% set lines = ((p | length) // NL_CHARS_PER_LINE) + 1 %}
{% set para_h = lines * NL_LINE_H + 8 %}
{% if ns_nl.current_h + para_h > NL_PAGE_BUDGET and ns_nl.current | length > 0 %}
{% set ns_nl.pages = ns_nl.pages + [ns_nl.current] %}
{% set ns_nl.current = [p] %}
{% set ns_nl.current_h = para_h %}
{% else %}
{% set ns_nl.current = ns_nl.current + [p] %}
{% set ns_nl.current_h = ns_nl.current_h + para_h %}
{% endif %}
{% endif %}
{% endfor %}
{% set articles_h = (cluster.articles | length) * NL_ARTICLE_COST + 20 %}
{% if ns_nl.current_h + articles_h > NL_PAGE_BUDGET and ns_nl.current | length > 0 %}
{% set ns_nl.pages = ns_nl.pages + [ns_nl.current] %}
{% set ns_nl.current = [] %}
{% endif %}
{% set ns_nl.pages = ns_nl.pages + [ns_nl.current] %}

{% for page_paras in ns_nl.pages %}
<div class="page page-newsletter" data-section-id="weekly_read" data-section-instance="cluster-{{ loop.index }}" data-source-path="newsletter_data.clusters" data-fit="bounded">
  <div class="page-header">The Weekly Read</div>

  {% if loop.first %}
  <h3 class="cluster-theme">{{ cluster.theme }}</h3>
  {% else %}
  <h3 class="cluster-theme cluster-theme-cont">{{ cluster.theme }} <span class="cluster-cont">(continued)</span></h3>
  {% endif %}
  {% if page_paras %}
  <div class="cluster-synthesis">
    {% for p in page_paras %}<p>{{ p }}</p>{% endfor %}
  </div>
  {% endif %}
  {% if loop.last %}
  <ul class="article-list">
  {% for article in cluster.articles %}
    <li>
      <span class="article-title">{{ article.title }}</span>
      {% if article.tags %}<span class="article-tags">({{ article.tags | join(', ') }})</span>{% endif %}
      {% if article.one_liner %}<span class="article-oneliner">{{ article.one_liner }}</span>{% endif %}
    </li>
  {% endfor %}
  </ul>
  {% endif %}

  <div class="page-folio">{{ ns.pg }}{% set ns.pg = ns.pg + 1 %}</div>
</div>
{% endfor %}
{% endfor %}

{# --- NEWSLETTER CLOSING PAGE: reflections + fun --- #}
{% if newsletter_data.reflections or newsletter_data.fun_section %}
<div class="page page-newsletter" data-section-id="weekly_read" data-section-instance="closing" data-source-path="newsletter_data.reflections" data-fit="bounded">
  <div class="page-header">The Weekly Read</div>

{% if newsletter_data.reflections %}
  <div class="through-line">
    <strong>The Through-Line:</strong> {{ newsletter_data.reflections }}
  </div>
{% endif %}

{% if newsletter_data.fun_section %}
  <div class="fun-section">
    <h3>{{ newsletter_data.fun_section.title | default("And Finally…") }}</h3>
    <p>{{ newsletter_data.fun_section.content }}</p>
    {% if newsletter_data.fun_section.source_url %}
    <p class="fun-source">Source: <a href="{{ newsletter_data.fun_section.source_url }}">{{ newsletter_data.fun_section.source_name | default("Link") }}</a></p>
    {% endif %}
  </div>
{% endif %}

  <p class="newsletter-footer">{{ newsletter_data.total_articles | default(0) }} articles · {{ newsletter_data.week_range | default(week_range) }}</p>
  <div class="page-folio">{{ ns.pg }}{% set ns.pg = ns.pg + 1 %}</div>
</div>
{% endif %}
{% endif %}

{# --- NEWS FEED --- #}
{% if news_feed_data and news_feed_data.sources %}
<div class="page page-divider" data-section-id="news_feed" data-section-instance="divider">
  <div class="divider-title">News Feed</div>
  <div class="divider-rule"></div>
  <div class="divider-sub">{{ news_feed_data.total_articles | default(0) }} articles from {{ news_feed_data.source_count | default(news_feed_data.sources | length) }} source{% if (news_feed_data.source_count | default(news_feed_data.sources | length)) != 1 %}s{% endif %}</div>
  <div class="page-folio">{{ ns.pg }}{% set ns.pg = ns.pg + 1 %}</div>
</div>

<div class="page page-newsletter page-news-feed" data-section-id="news_feed" data-section-instance="articles" data-source-path="news_feed_data.articles" data-fit="bounded">
  <div class="page-header">News Feed</div>
  <h2 class="section-header">Recent Articles</h2>
  {% if news_feed_data.articles %}
  <ul class="article-list">
    {% for article in news_feed_data.articles[:8] %}
    <li>
      <span class="article-title">{{ article.title }}</span>
      <span class="article-tags">({{ article.source_name }}{% if article.published_at %}, {{ article.published_at }}{% endif %})</span>
      {% if article.summary %}<span class="article-oneliner">{{ article.summary }}</span>{% endif %}
    </li>
    {% endfor %}
  </ul>
  {% else %}
  <p>No articles matched the requested publication window.</p>
  {% endif %}
  {% if news_feed_data.markdown_path %}
  <p class="newsletter-footer">Full extracted text: {{ news_feed_data.markdown_path }}</p>
  {% endif %}
  <div class="page-folio">{{ ns.pg }}{% set ns.pg = ns.pg + 1 %}</div>
</div>
{% endif %}

{# --- NUTRITION --- #}
{% if nutrition_summary or nutrition_data %}
<div class="page page-nutrition" data-section-id="nutrition" data-section-instance="summary" data-source-path="nutrition_summary" data-fit="bounded">
  <div class="page-header">Family Health</div>
  <h2 class="section-header">Nutrition</h2>
  {% if nutrition_summary %}
  <div class="nutrition-summary">{{ nutrition_summary }}</div>
  {% endif %}

  {% set lunch_items = nutrition_data.lunch_suggestions | default(nutrition_data.recommended_lunches | default([])) if nutrition_data else [] %}
  {% if lunch_items %}
  <h3 class="subsection-label">Lunch moves</h3>
  <ul class="nutrition-list">
    {% for item in lunch_items[:4] %}
    {% if item is string %}
    <li>{{ item }}</li>
    {% else %}
    <li><strong>{{ item.name | default("Lunch") }}</strong>{% if item.description %} — {{ item.description }}{% endif %}{% if item.nutrients %} <em>({{ item.nutrients | join(", ") }})</em>{% elif item.key_nutrients %} <em>({{ item.key_nutrients | join(", ") }})</em>{% endif %}</li>
    {% endif %}
    {% endfor %}
  </ul>
  {% endif %}

  {% set snack_items = nutrition_data.snack_suggestions | default(nutrition_data.recommended_snacks | default([])) if nutrition_data else [] %}
  {% if snack_items %}
  <h3 class="subsection-label">Snack moves</h3>
  <ul class="nutrition-list">
    {% for item in snack_items[:4] %}
    {% if item is string %}
    <li>{{ item }}</li>
    {% else %}
    <li><strong>{{ item.name | default("Snack") }}</strong>{% if item.description %} — {{ item.description }}{% endif %}{% if item.nutrients %} <em>({{ item.nutrients | join(", ") }})</em>{% elif item.key_nutrients %} <em>({{ item.key_nutrients | join(", ") }})</em>{% endif %}</li>
    {% endif %}
    {% endfor %}
  </ul>
  {% endif %}

  {% if nutrition_data and nutrition_data.nutrient_primer %}
  <div class="nutrition-primer">
    {% if nutrition_data.nutrient_primer is string %}
    {{ nutrition_data.nutrient_primer }}
    {% else %}
    {% for item in nutrition_data.nutrient_primer[:2] %}
    <p><strong>{{ item.nutrient | default("Nutrient") }}:</strong> {{ item.why_it_matters | default("") }}</p>
    {% endfor %}
    {% endif %}
  </div>
  {% endif %}
  <div class="page-folio">{{ ns.pg }}{% set ns.pg = ns.pg + 1 %}</div>
</div>
{% endif %}

{# --- EXTRA SECTIONS (extensible, non-parenting) --- #}
{% if extra_sections %}
{% for section in extra_sections %}
{% if "Parenting" not in section.title %}
<div class="page page-extra" data-section-id="extra" data-section-instance="{{ section.title | replace(' ', '-') | lower }}" data-fit="bounded">
  <div class="page-header">Extras</div>
  <h2 class="section-header">{{ section.title }}</h2>
  <div class="extra-content">{{ section.content }}</div>
  <div class="page-folio">{{ ns.pg }}{% set ns.pg = ns.pg + 1 %}</div>
</div>
{% endif %}
{% endfor %}
{% endif %}

{# --- BEDTIME STORY (multi-page) --- #}
{% if child_wisdom %}
<div class="page page-divider" data-section-id="bedtime_story" data-section-instance="divider">
  <div class="divider-title">Bedtime Story</div>
  <div class="divider-rule"></div>
  <div class="divider-sub">{{ child_wisdom.title }}</div>
  <div class="page-folio">{{ ns.pg }}{% set ns.pg = ns.pg + 1 %}</div>
</div>

{% set paragraphs = child_wisdom.story.split('\n\n') %}
{% set ns_story = namespace(page_paras=[]) %}
{% for para in paragraphs %}
{% if para.strip() %}
{% set ns_story.page_paras = ns_story.page_paras + [para.strip()] %}
{% endif %}
{% endfor %}

{# Render story pages — estimate paragraph heights by character count to fill A5 pages.
   Measured: dialog lines (~20 chars) = 18px, medium (~100 chars) = 36px, long (~200 chars) = 54-72px.
   At 8.5pt justified on A5: ~70 usable chars per line, 18px per line.
   Usable height ~660px. Title ~50px on page 1. Target ~85% fill. #}
{% set ns_page = namespace(pages=[], current=[], current_h=0) %}
{% set PAGE_BUDGET = 640 %}
{% set TITLE_COST = 55 %}
{% set PROMPT_COST = 35 %}
{% set LINE_H = 18 %}

{% for para in ns_story.page_paras %}
{# Estimate height: ~70 chars per line at 8.5pt justified on A5 #}
{% set lines = ((para | length) // 70) + 1 %}
{% set para_h = lines * LINE_H %}
{% set is_first_page = (ns_page.pages | length == 0 and ns_page.current | length == 0) %}
{% set budget = PAGE_BUDGET - (TITLE_COST if is_first_page else 0) %}

{% if ns_page.current_h + para_h > budget and ns_page.current | length > 0 %}
{# Page full — start new page #}
{% set ns_page.pages = ns_page.pages + [ns_page.current] %}
{% set ns_page.current = [para] %}
{% set ns_page.current_h = para_h %}
{% else %}
{% set ns_page.current = ns_page.current + [para] %}
{% set ns_page.current_h = ns_page.current_h + para_h %}
{% endif %}
{% endfor %}

{# Flush last page #}
{% if ns_page.current | length > 0 %}
{% set ns_page.pages = ns_page.pages + [ns_page.current] %}
{% endif %}

{% set total_pages = ns_page.pages | length %}
{% for page_paras in ns_page.pages %}
<div class="page page-story{% if loop.index0 == 0 %} page-story-first{% endif %}" data-section-id="bedtime_story" data-section-instance="page-{{ loop.index }}" data-source-path="child_wisdom.story" data-fit="bounded">
  <div class="page-header">Bedtime Story</div>
  {% if loop.index0 == 0 %}
  <h3 class="story-title">{{ child_wisdom.title }}</h3>
  {% endif %}
  <div class="story-text">
    {% for para in page_paras %}
    <p>{{ para }}</p>
    {% endfor %}
  </div>
  {% if loop.last and child_wisdom.discussion_prompt %}
  <div class="story-prompt">{{ child_wisdom.discussion_prompt }}</div>
  {% endif %}
  <div class="page-folio">{{ ns.pg }}{% set ns.pg = ns.pg + 1 %}</div>
</div>
{% endfor %}
{% endif %}

{# --- BACK COVER --- #}
<div class="page page-back" data-section-id="notes_back_cover" data-source-path="generated_at" data-fit="bounded">
  <div class="back-inner">
  <div class="back-divider"></div>
  <div class="colophon">{{ week_range }} · Generated {{ generated_at }}</div>
  </div>
</div>
