<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Weekly Planner — {{ week_range }}</title>
<style>
/* ========================================
   BASE STYLES — Mobile-first, minimalist
   ======================================== */

:root {
  --ink: #1a1a1a;
  --muted: #6b6b6b;
  --accent: #2c5f2d;
  --accent-light: #e8f0e8;
  --accent-warm: #c0392b;
  --accent-warm-light: #fdf0ee;
  --bg: #fafaf8;
  --border: #e0ddd8;
  --card-bg: #ffffff;
  --font-sans: 'Segoe UI', system-ui, -apple-system, sans-serif;
  --font-serif: Georgia, 'Times New Roman', serif;
  --font-mono: 'Cascadia Code', 'Consolas', monospace;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: var(--font-sans);
  font-size: 15px;
  line-height: 1.6;
  color: var(--ink);
  background: var(--bg);
  -webkit-font-smoothing: antialiased;
}

/* ========================================
   SCREEN LAYOUT — Mobile HTML
   ======================================== */

.page { display: none; } /* pages are for print only */

@media screen {
  .screen-container {
    max-width: 640px;
    margin: 0 auto;
    padding: 16px;
  }

  .cover-screen {
    text-align: center;
    padding: 48px 20px 32px;
    border-bottom: 2px solid var(--border);
    margin-bottom: 24px;
  }
  .cover-screen h1 {
    font-family: var(--font-serif);
    font-size: 28px;
    font-weight: 400;
    letter-spacing: -0.5px;
    margin-bottom: 8px;
  }
  .cover-screen .week-range {
    font-size: 14px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 2px;
  }
  .cover-screen .highlight {
    margin-top: 24px;
    padding: 16px;
    background: var(--accent-light);
    border-radius: 8px;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 16px;
    color: var(--accent);
  }

  .section-title {
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 400;
    margin: 32px 0 16px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
  }

  .glance-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
    margin-bottom: 24px;
  }
  .glance-table th {
    text-align: left;
    font-weight: 600;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--muted);
    padding: 8px 6px;
    border-bottom: 2px solid var(--border);
  }
  .glance-table td {
    padding: 10px 6px;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }
  .glance-table .day-name { font-weight: 600; white-space: nowrap; }

  .day-card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
    margin-bottom: 16px;
  }
  .day-card h3 {
    font-family: var(--font-serif);
    font-size: 18px;
    font-weight: 400;
    margin-bottom: 4px;
  }
  .day-card .weather {
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 12px;
  }
  .day-card .dinner-title {
    font-weight: 600;
    font-size: 16px;
    color: var(--accent);
    margin-bottom: 4px;
  }
  .day-card .cuisine-tag {
    display: inline-block;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 2px 8px;
    margin-bottom: 8px;
  }
  .day-card .description { font-size: 14px; margin-bottom: 10px; }
  .day-card .ingredients {
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 8px;
  }
  .day-card .notes {
    font-size: 13px;
    font-style: italic;
    color: var(--muted);
    margin-bottom: 12px;
  }
  .day-card .album-pairing {
    background: var(--accent-light);
    border-radius: 6px;
    padding: 12px;
    margin-top: 12px;
  }
  .day-card .album-name {
    font-weight: 600;
    font-size: 14px;
  }
  .day-card .album-meta {
    font-size: 12px;
    color: var(--muted);
  }
  .day-card .album-desc {
    font-size: 13px;
    margin-top: 6px;
  }
  .day-card .album-sonic {
    font-size: 12px;
    color: var(--muted);
    margin-top: 4px;
  }
  .day-card .album-rationale {
    font-size: 13px;
    font-style: italic;
    margin-top: 6px;
  }

  .day-card .elevation-tips {
    margin-top: 12px;
    padding: 12px;
    background: #fef9f0;
    border-radius: 6px;
    border-left: 3px solid #e67e22;
  }
  .day-card .elevation-tips h4 {
    font-size: 13px;
    font-weight: 600;
    color: #e67e22;
    margin-bottom: 6px;
  }
  .day-card .elevation-tip {
    font-size: 13px;
    margin-bottom: 6px;
    padding-left: 8px;
  }
  .day-card .elevation-tip .tip-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #e67e22;
    font-weight: 600;
  }

  .weather-emoji { font-size: 16px; margin-right: 4px; }

  /* Links */
  .day-card a, .appetizer-card a, .salad-card a, .beverage-card a {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px dotted var(--accent);
    transition: border-color 0.2s;
  }
  .day-card a:hover, .appetizer-card a:hover, .salad-card a:hover, .beverage-card a:hover {
    border-bottom-style: solid;
  }
  .spotify-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 12px;
    color: #1DB954;
    border-bottom: none !important;
    font-weight: 600;
    margin-top: 6px;
  }
  .spotify-link:hover { opacity: 0.8; }
  .recipe-link {
    display: inline-block;
    font-size: 12px;
    margin-top: 4px;
  }

  /* Detailed prep section */
  .prep-detail {
    margin-top: 16px;
    padding: 16px;
    background: #f8f7f4;
    border-radius: 8px;
    border: 1px solid var(--border);
  }
  .prep-detail summary {
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
    color: var(--accent);
    list-style: none;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .prep-detail summary::-webkit-details-marker { display: none; }
  .prep-detail summary::before { content: "▶ "; font-size: 10px; transition: transform 0.2s; }
  .prep-detail[open] summary::before { content: "▼ "; }
  .prep-detail .prep-meta {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin: 10px 0;
    font-size: 12px;
  }
  .prep-detail .prep-meta-item {
    background: var(--accent-light);
    padding: 4px 10px;
    border-radius: 4px;
    color: var(--accent);
    font-weight: 600;
  }
  .prep-detail .prep-steps {
    counter-reset: prep-step;
    list-style: none;
    padding: 0;
    margin-top: 8px;
  }
  .prep-detail .prep-steps li {
    counter-increment: prep-step;
    position: relative;
    padding: 8px 0 8px 36px;
    font-size: 13px;
    line-height: 1.5;
    border-bottom: 1px solid var(--border);
  }
  .prep-detail .prep-steps li:last-child { border-bottom: none; }
  .prep-detail .prep-steps li::before {
    content: counter(prep-step);
    position: absolute;
    left: 0;
    top: 8px;
    width: 24px;
    height: 24px;
    background: var(--accent);
    color: white;
    border-radius: 50%;
    font-size: 11px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .prep-detail .prep-equipment {
    margin-top: 8px;
    font-size: 12px;
    color: var(--muted);
  }
  .prep-detail .prep-make-ahead {
    margin-top: 8px;
    padding: 8px 12px;
    background: #fff8e1;
    border-left: 3px solid #f9a825;
    border-radius: 0 4px 4px 0;
    font-size: 12px;
    font-style: italic;
  }

  /* Parenting section — screen */
  .parenting-section {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
    margin-bottom: 16px;
  }
  .parenting-section .theme-banner {
    background: var(--accent-warm-light);
    border-radius: 6px;
    padding: 16px;
    margin-bottom: 16px;
  }
  .parenting-section .theme-banner h3 {
    font-family: var(--font-serif);
    font-size: 18px;
    color: var(--accent-warm);
    margin-bottom: 6px;
  }
  .parenting-section .theme-banner p { font-size: 14px; }
  .parenting-section .question-card {
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
  }
  .parenting-section .question-card:last-child { border-bottom: none; }
  .parenting-section .question-day {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--accent-warm);
    font-weight: 600;
  }
  .parenting-section .question-text {
    font-family: var(--font-serif);
    font-size: 15px;
    font-style: italic;
    margin: 4px 0;
  }
  .parenting-section .question-why {
    font-size: 12px;
    color: var(--muted);
  }
  .parenting-section .nudge-card {
    background: var(--accent-warm-light);
    border-radius: 6px;
    padding: 12px;
    margin-bottom: 10px;
  }
  .parenting-section .nudge-card h4 {
    font-size: 14px;
    color: var(--accent-warm);
    margin-bottom: 4px;
  }
  .parenting-section .nudge-card p { font-size: 13px; }
  .parenting-section .nudge-steps {
    font-size: 12px;
    margin-top: 6px;
    padding-left: 16px;
  }
  .parenting-section .nudge-steps li { margin-bottom: 3px; }
  .parenting-section .reflection-box {
    border-left: 3px solid var(--accent-warm);
    padding: 12px 16px;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 14px;
    margin-top: 16px;
    background: var(--accent-warm-light);
    border-radius: 0 6px 6px 0;
  }
  .parenting-section .book-rec {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 12px;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    margin-top: 12px;
  }
  .parenting-section .book-rec .book-icon { font-size: 28px; }
  .parenting-section .book-rec .book-info h4 { font-size: 14px; margin-bottom: 2px; }
  .parenting-section .book-rec .book-info p { font-size: 13px; color: var(--muted); }
  .day-card .prep-notes {
    margin-top: 12px;
    padding-top: 10px;
    border-top: 1px solid var(--border);
  }
  .day-card .prep-notes h4 {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--muted);
    margin-bottom: 4px;
  }
  .day-card .prep-notes li {
    font-size: 13px;
    margin-left: 16px;
    margin-bottom: 2px;
  }

  .support-section {
    margin-bottom: 24px;
  }
  .support-section h4 {
    font-size: 15px;
    font-weight: 600;
    margin-bottom: 6px;
  }
  .support-section p, .support-section li {
    font-size: 14px;
    line-height: 1.5;
  }
  .support-section li {
    margin-left: 16px;
    margin-bottom: 3px;
  }

  .salad-card, .appetizer-card, .beverage-card {
    border-left: 3px solid var(--accent);
    padding: 12px 16px;
    margin-bottom: 12px;
    background: var(--card-bg);
  }
  .salad-card .salad-type {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--accent);
    margin-bottom: 4px;
  }
  .salad-card .dressing {
    font-size: 13px;
    margin-top: 8px;
    padding: 8px;
    background: var(--accent-light);
    border-radius: 4px;
  }
  .salad-card .rationale {
    font-size: 13px;
    font-style: italic;
    color: var(--muted);
    margin-top: 6px;
  }

  .grocery-section {
    columns: 2;
    column-gap: 24px;
  }
  .grocery-category {
    break-inside: avoid;
    margin-bottom: 16px;
  }
  .grocery-category h4 {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--accent);
    margin-bottom: 4px;
  }
  .grocery-category li {
    font-size: 13px;
    margin-left: 16px;
    margin-bottom: 2px;
  }

  .prep-checklist li {
    font-size: 14px;
    margin-left: 16px;
    margin-bottom: 4px;
    list-style: none;
  }
  .prep-checklist li::before {
    content: "☐ ";
    color: var(--muted);
  }

  .extra-section {
    margin-bottom: 24px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }
  .extra-section h3 {
    font-family: var(--font-serif);
    font-size: 18px;
    font-weight: 400;
    margin-bottom: 10px;
  }

  .footer {
    text-align: center;
    padding: 24px;
    font-size: 12px;
    color: var(--muted);
    border-top: 1px solid var(--border);
    margin-top: 32px;
  }
}

/* ========================================
   PRINT LAYOUT — Half-letter booklet
   5.5" × 8.5" pages (folded from 8.5" × 11")
   ======================================== */

@media print {
  .screen-container { display: none !important; }

  @page {
    size: 5.5in 8.5in;
    margin: 0.5in 0.4in 0.55in 0.4in;
  }

  body {
    font-size: 9.5pt;
    line-height: 1.4;
    background: white;
    color: #1a1a1a;
    counter-reset: page-num;
  }

  /* ---- Page container ---- */
  .page {
    display: block;
    page-break-after: always;
    position: relative;
    min-height: 0;
  }
  .page:last-child { page-break-after: avoid; }

  /* ---- Page furniture: folio + running header ---- */
  .page-folio {
    position: absolute;
    bottom: -0.25in;
    left: 0;
    right: 0;
    text-align: center;
    font-size: 7pt;
    color: #aaa;
  }
  .page-header {
    font-size: 6.5pt;
    text-transform: uppercase;
    letter-spacing: 1.5pt;
    color: #bbb;
    margin-bottom: 8pt;
  }
  .page-cover .page-folio,
  .page-back .page-folio,
  .page-cover .page-header,
  .page-back .page-header,
  .page-divider .page-folio { display: none; }

  /* ---- Shared section header ---- */
  .section-header {
    font-family: var(--font-serif);
    font-size: 13pt;
    font-weight: 400;
    margin-bottom: 8pt;
    padding-bottom: 4pt;
    border-bottom: 0.75pt solid #ccc;
  }

  /* ---- Section divider pages ---- */
  .page-divider {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    height: 7.0in;
  }
  .page-divider .divider-title {
    font-family: var(--font-serif);
    font-size: 20pt;
    font-weight: 400;
    letter-spacing: -0.3pt;
    margin-bottom: 6pt;
  }
  .page-divider .divider-rule {
    width: 30pt;
    height: 0.75pt;
    background: #ccc;
    margin: 0 auto 8pt;
  }
  .page-divider .divider-sub {
    font-size: 8pt;
    color: #888;
    font-style: italic;
    max-width: 3in;
    line-height: 1.4;
  }

  /* ---- COVER ---- */
  .page-cover {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    height: 7.0in;
  }
  .page-cover h1 {
    font-family: var(--font-serif);
    font-size: 22pt;
    font-weight: 400;
    letter-spacing: -0.5pt;
    margin-bottom: 6pt;
  }
  .page-cover .week-range {
    font-size: 9pt;
    text-transform: uppercase;
    letter-spacing: 3pt;
    color: #666;
    margin-bottom: 20pt;
  }
  .page-cover .divider {
    width: 36pt;
    height: 0.75pt;
    background: #999;
    margin: 0 auto 20pt;
  }
  .page-cover .highlight-text {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 11pt;
    color: #444;
    max-width: 3.2in;
    line-height: 1.5;
  }

  /* ---- GLANCE ---- */
  .page-glance table {
    width: 100%;
    border-collapse: collapse;
    font-size: 7.5pt;
  }
  .page-glance th {
    text-align: left;
    font-size: 6.5pt;
    text-transform: uppercase;
    letter-spacing: 0.5pt;
    color: #666;
    padding: 3pt 3pt;
    border-bottom: 1.5pt solid #333;
  }
  .page-glance td {
    padding: 4pt 3pt;
    border-bottom: 0.5pt solid #ddd;
    vertical-align: top;
  }
  .page-glance .day-name { font-weight: 600; }

  /* ---- DAY PAGES ---- */
  .page-day .day-intro {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 8pt;
    color: #555;
    margin-bottom: 6pt;
    line-height: 1.4;
  }
  .page-day .weather-line {
    font-size: 7.5pt;
    color: #666;
    margin-bottom: 8pt;
  }
  .page-day .dinner-block {
    margin-bottom: 8pt;
    page-break-inside: avoid;
  }
  .page-day .dinner-name {
    font-size: 11pt;
    font-weight: 600;
    margin-bottom: 2pt;
  }
  .page-day .cuisine-label {
    font-size: 6.5pt;
    text-transform: uppercase;
    letter-spacing: 1pt;
    color: #888;
    margin-bottom: 3pt;
  }
  .page-day .dinner-desc {
    font-size: 8.5pt;
    margin-bottom: 4pt;
  }
  .page-day .ingredients-line {
    font-size: 7.5pt;
    color: #666;
    margin-bottom: 3pt;
  }
  .page-day .notes-line {
    font-size: 7.5pt;
    font-style: italic;
    color: #666;
    margin-bottom: 6pt;
  }
  .page-day .album-block {
    border-top: 0.5pt solid #ddd;
    padding: 5pt 0;
    margin-bottom: 6pt;
    page-break-inside: avoid;
  }
  .page-day .album-title {
    font-size: 8.5pt;
    font-weight: 600;
  }
  .page-day .album-info {
    font-size: 7.5pt;
    color: #666;
  }
  .page-day .album-why {
    font-size: 7.5pt;
    font-style: italic;
    margin-top: 2pt;
  }
  .page-day .album-desc {
    font-size: 7.5pt;
    margin-top: 2pt;
  }
  .page-day .album-sonic {
    font-size: 7pt;
    color: #666;
    margin-top: 1pt;
  }
  .page-day .elevation-block {
    margin-top: 5pt;
    padding: 4pt 6pt;
    background: #fef9f0;
    border-left: 2pt solid #e67e22;
    page-break-inside: avoid;
  }
  .page-day .elevation-block h4 {
    font-size: 6.5pt;
    text-transform: uppercase;
    letter-spacing: 0.5pt;
    color: #e67e22;
    margin-bottom: 2pt;
  }
  .page-day .elevation-tip {
    font-size: 7pt;
    margin-bottom: 2pt;
  }
  .page-day .elevation-tip .tip-label {
    font-size: 6pt;
    text-transform: uppercase;
    letter-spacing: 0.3pt;
    color: #e67e22;
    font-weight: 600;
  }
  .weather-emoji-print { font-size: 8pt; }
  .page-day .calendar-block {
    font-size: 7.5pt;
    margin-bottom: 5pt;
    padding: 3pt 6pt;
    border-left: 2pt solid #ddd;
  }
  .page-day .prep-block {
    margin-top: 5pt;
    padding-top: 3pt;
    border-top: 0.5pt solid #ddd;
    page-break-inside: avoid;
  }
  .page-day .prep-block h4 {
    font-size: 6.5pt;
    text-transform: uppercase;
    letter-spacing: 0.5pt;
    color: #888;
    margin-bottom: 2pt;
  }
  .page-day .prep-block li {
    font-size: 7.5pt;
    margin-left: 12pt;
    margin-bottom: 1pt;
  }

  /* ---- SUPPORT PAGES (appetizers, salads, beverages) ---- */
  .page-support h3 {
    font-size: 9.5pt;
    font-weight: 600;
    margin: 6pt 0 2pt;
  }
  .page-support p {
    font-size: 8.5pt;
    margin-bottom: 3pt;
  }
  .page-support .salad-entry {
    margin-bottom: 8pt;
    padding-bottom: 5pt;
    border-bottom: 0.5pt solid #eee;
    page-break-inside: avoid;
  }
  .page-support .type-label {
    font-size: 6.5pt;
    text-transform: uppercase;
    letter-spacing: 0.5pt;
    color: #888;
  }
  .page-support .dressing-box {
    font-size: 7.5pt;
    padding: 3pt 6pt;
    background: #f5f5f2;
    margin: 3pt 0;
  }
  .page-support .rationale {
    font-size: 7.5pt;
    font-style: italic;
    color: #666;
  }
  .page-support li {
    font-size: 8.5pt;
    margin-left: 12pt;
    margin-bottom: 2pt;
  }

  /* ---- GROCERY ---- */
  .page-grocery .grocery-cols {
    columns: 2;
    column-gap: 14pt;
  }
  .page-grocery .g-cat {
    break-inside: avoid;
    margin-bottom: 6pt;
  }
  .page-grocery .g-cat h4 {
    font-size: 7.5pt;
    text-transform: uppercase;
    letter-spacing: 0.5pt;
    margin-bottom: 2pt;
    color: #333;
  }
  .page-grocery .g-cat li {
    font-size: 7.5pt;
    margin-left: 10pt;
    margin-bottom: 1pt;
  }
  .page-grocery .prep-list {
    margin-top: 8pt;
    padding-top: 6pt;
    border-top: 0.5pt solid #ddd;
  }
  .page-grocery .prep-list h3 {
    font-size: 9.5pt;
    font-weight: 600;
    margin-bottom: 4pt;
  }
  .page-grocery .prep-list li {
    font-size: 7.5pt;
    margin-left: 10pt;
    margin-bottom: 2pt;
    list-style: none;
  }
  .page-grocery .prep-list li::before {
    content: "☐ ";
    color: #999;
  }

  /* ---- EXTRA SECTIONS ---- */
  .page-extra .extra-content {
    font-size: 8.5pt;
  }

  /* ---- PARENTING ---- */
  .page-parenting .theme-banner {
    padding: 5pt 7pt;
    background: #fdf0ee;
    margin-bottom: 6pt;
  }
  .page-parenting .theme-banner h3 {
    font-size: 9.5pt;
    font-weight: 600;
    color: #c0392b;
    margin-bottom: 2pt;
  }
  .page-parenting .theme-banner p { font-size: 7.5pt; }
  .page-parenting .question-entry {
    padding: 2pt 0;
    border-bottom: 0.5pt solid #eee;
    page-break-inside: avoid;
  }
  .page-parenting .question-day {
    font-size: 6.5pt;
    text-transform: uppercase;
    letter-spacing: 0.5pt;
    color: #c0392b;
    font-weight: 600;
  }
  .page-parenting .question-text {
    font-family: var(--font-serif);
    font-size: 8.5pt;
    font-style: italic;
    margin: 1pt 0;
  }
  .page-parenting .question-why {
    font-size: 6.5pt;
    color: #666;
  }
  .page-parenting .nudge-card {
    padding: 4pt 6pt;
    background: #fdf0ee;
    margin-bottom: 5pt;
    page-break-inside: avoid;
  }
  .page-parenting .nudge-card h4 {
    font-size: 8.5pt;
    color: #c0392b;
    margin-bottom: 2pt;
  }
  .page-parenting .nudge-card p { font-size: 7.5pt; }
  .page-parenting .nudge-steps {
    font-size: 7pt;
    margin-top: 2pt;
    padding-left: 10pt;
  }
  .page-parenting .nudge-steps li { margin-bottom: 1pt; }
  .page-parenting .reflection-box {
    border-left: 2pt solid #c0392b;
    padding: 4pt 6pt;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 7.5pt;
    margin-top: 5pt;
    background: #fdf0ee;
  }
  .page-parenting .book-rec {
    padding: 4pt 6pt;
    border: 0.5pt solid #ddd;
    margin-top: 5pt;
    page-break-inside: avoid;
  }
  .page-parenting .book-rec h4 { font-size: 8.5pt; margin-bottom: 1pt; }
  .page-parenting .book-rec p { font-size: 7.5pt; color: #666; }

  /* ---- BACK COVER ---- */
  .page-back {
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 7.0in;
    text-align: center;
  }
  .page-back .back-inner {
    max-width: 3.8in;
    margin: 0 auto;
  }
  .page-back .notes-section {
    text-align: left;
    margin-bottom: 14pt;
  }
  .page-back .notes-section h3 {
    font-family: var(--font-serif);
    font-size: 10pt;
    font-weight: 400;
    margin-bottom: 4pt;
    padding-bottom: 3pt;
    border-bottom: 0.5pt solid #ddd;
  }
  .page-back .notes-section li {
    font-size: 7.5pt;
    margin-left: 10pt;
    margin-bottom: 2pt;
    text-align: left;
  }
  .page-back .nutrition {
    font-size: 7.5pt;
    color: #555;
    margin-bottom: 14pt;
    padding: 6pt 8pt;
    background: #f8f8f6;
    border: 0.5pt solid #e0ddd8;
    text-align: left;
  }
  .page-back .nutrition strong {
    display: block;
    font-size: 8pt;
    margin-bottom: 3pt;
    color: #333;
  }
  .page-back .back-divider {
    width: 30pt;
    height: 0.75pt;
    background: #ccc;
    margin: 12pt auto;
  }
  .page-back .colophon {
    font-size: 7pt;
    color: #aaa;
    font-style: italic;
  }
}
</style>
</head>
<body>

{# --- Weather Emoji Macro --- #}
{% macro weather_icon(weather_text) -%}
{%- set w = weather_text | default("") | lower -%}
{%- if "snow" in w or "blizzard" in w -%}❄️
{%- elif "rain" in w or "drizzle" in w or "shower" in w -%}🌧️
{%- elif "thunder" in w or "storm" in w -%}⛈️
{%- elif "clear" in w -%}☀️
{%- elif "partly" in w or "mostly sunny" in w -%}🌤️
{%- elif "overcast" in w and (weather_text | default("") | lower).startswith("overcast") -%}☁️
{%- elif "cloud" in w -%}⛅
{%- elif "fog" in w or "mist" in w -%}🌫️
{%- else -%}🌤️
{%- endif -%}
{%- endmacro %}

{# ============================================
   PRINT PAGES — booklet layout
   ============================================ #}

{# --- COVER PAGE --- #}
<div class="page page-cover">
  <h1>Weekly Planner</h1>
  <div class="week-range">{{ week_range }}</div>
  <div class="divider"></div>
  {% if highlight %}
  <div class="highlight-text">{{ highlight }}</div>
  {% endif %}
</div>

{# --- WEEK AT A GLANCE --- #}
<div class="page page-glance">
  <div class="page-header">Overview</div>
  <h2 class="section-header">Week at a Glance</h2>
  <table>
    <thead>
      <tr>
        <th>Day</th>
        <th></th>
        <th>Weather</th>
        <th>Events</th>
        <th>Dinner</th>
        <th>Album</th>
      </tr>
    </thead>
    <tbody>
      {% for day in days %}
      <tr>
        <td class="day-name">{{ day.name }}</td>
        <td><span class="weather-emoji-print">{{ weather_icon(day.weather) }}</span></td>
        <td>{{ day.weather | default("—") }}</td>
        <td>{% if day.calendar_items %}{% for item in day.calendar_items %}{{ item }}{% if not loop.last %}; {% endif %}{% endfor %}{% else %}—{% endif %}</td>
        <td>{{ day.dinner | default("—") }}</td>
        <td>{{ day.album | default("—") }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  <div class="page-folio">2</div>
</div>

{# --- SECTION DIVIDER: Daily Plan --- #}
<div class="page page-divider">
  <div class="divider-title">Daily Plan</div>
  <div class="divider-rule"></div>
  <div class="divider-sub">Seven days of dinner, music, and good company</div>
</div>

{# --- DAILY PAGES --- #}
{% for day in days %}
<div class="page page-day">
  <div class="page-header">Daily Plan</div>
  <h2 class="section-header">{{ day.long_name }}</h2>
  {% if day.day_intro %}
  <div class="day-intro">{{ day.day_intro }}</div>
  {% endif %}
  {% if day.weather %}
  <div class="weather-line"><span class="weather-emoji-print">{{ weather_icon(day.weather) }}</span> {{ day.weather }}{% if day.weather_detail %} · {{ day.weather_detail }}{% endif %}</div>
  {% endif %}

  {% if day.calendar_items %}
  <div class="calendar-block">
    {% for item in day.calendar_items %}<div>📅 {{ item }}</div>{% endfor %}
  </div>
  {% endif %}

  {% if day.dinner %}
  <div class="dinner-block">
    <div class="dinner-name">{{ day.dinner }}</div>
    {% if day.dinner_cuisine %}<div class="cuisine-label">{{ day.dinner_cuisine }}</div>{% endif %}
    {% if day.dinner_description %}<div class="dinner-desc">{{ day.dinner_description }}</div>{% endif %}
    {% if day.dinner_key_ingredients %}
    <div class="ingredients-line">{{ day.dinner_key_ingredients | join(", ") }}</div>
    {% endif %}
    {% if day.dinner_notes %}<div class="notes-line">{{ day.dinner_notes }}</div>{% endif %}
  </div>
  {% endif %}

  {% if day.dinner_elevation_tips %}
  <div class="elevation-block">
    <h4>Chef's Tips</h4>
    {% for tip in day.dinner_elevation_tips %}
    <div class="elevation-tip">
      <span class="tip-label">{{ tip.type }}:</span> <strong>{{ tip.title }}</strong> — {{ tip.instruction }}
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {% if day.album %}
  <div class="album-block">
    <div class="album-title">🎵 {{ day.album }}</div>
    <div class="album-info">{{ day.album_year | default("") }} · {{ day.album_genre | default("") }} · {{ day.album_mood | default("") }}</div>
    {% if day.album_description %}<div class="album-desc">{{ day.album_description }}</div>{% endif %}
    {% if day.album_sonic_description %}<div class="album-sonic">🔊 {{ day.album_sonic_description }}</div>{% endif %}
    {% if day.album_pairing_rationale %}<div class="album-why">{{ day.album_pairing_rationale }}</div>{% endif %}
  </div>
  {% endif %}

  {% if day.prep_notes %}
  <div class="prep-block">
    <h4>Prep</h4>
    <ul>{% for note in day.prep_notes %}<li>{{ note }}</li>{% endfor %}</ul>
  </div>
  {% endif %}
  <div class="page-folio">{{ loop.index + 3 }}</div>
</div>
{% endfor %}

{# --- SECTION DIVIDER: Kitchen & Pantry --- #}
{% if salads or appetizers or beverages or grocery_list %}
<div class="page page-divider">
  <div class="divider-title">Kitchen & Pantry</div>
  <div class="divider-rule"></div>
  <div class="divider-sub">Appetizers, salads, beverages, and your shopping list</div>
</div>
{% endif %}

{# --- APPETIZERS & SALADS --- #}
{% if salads or appetizers %}
<div class="page page-support">
  <div class="page-header">Kitchen & Pantry</div>
  {% if appetizers %}
  <h2 class="section-header">Appetizers</h2>
  {% for a in appetizers %}
  <h3>{{ a.name }}</h3>
  <p>{{ a.description | default("") }}</p>
  {% if a.key_ingredients %}<p style="font-size:7.5pt;color:#666;">{{ a.key_ingredients | join(", ") }}</p>{% endif %}
  {% endfor %}
  {% endif %}

  {% if salads %}
  <h2 class="section-header" style="margin-top:10pt;">Salads</h2>
  {% for s in salads %}
  <div class="salad-entry">
    <div class="type-label">{{ s.salad_type | default("side") | replace("_", " ") }}</div>
    <h3>{{ s.name }}</h3>
    <p>{{ s.description | default("") }}</p>
    {% if s.dressing %}<div class="dressing-box"><strong>Dressing:</strong> {{ s.dressing }}</div>{% endif %}
    {% if s.flavor_rationale %}<div class="rationale">{{ s.flavor_rationale }}</div>{% endif %}
  </div>
  {% endfor %}
  {% endif %}
  <div class="page-folio"></div>
</div>
{% endif %}

{# --- BEVERAGES --- #}
{% if beverages %}
<div class="page page-support">
  <div class="page-header">Kitchen & Pantry</div>
  <h2 class="section-header">Beverage Pairings</h2>
  {% for b in beverages %}
  <h3>{{ b.name }}</h3>
  <p>{{ b.description | default("") }}</p>
  {% if b.why %}<p style="font-size:7.5pt;font-style:italic;color:#666;">{{ b.why }}</p>{% endif %}
  {% endfor %}
  <div class="page-folio"></div>
</div>
{% endif %}

{# --- GROCERY LIST --- #}
<div class="page page-grocery">
  <div class="page-header">Kitchen & Pantry</div>
  <h2 class="section-header">Grocery List</h2>
  {% if grocery_list %}
  <div class="grocery-cols">
    {% for category, items in grocery_list.items() %}
    <div class="g-cat">
      <h4>{{ category }}</h4>
      <ul>{% for item in items %}<li>{{ item }}</li>{% endfor %}</ul>
    </div>
    {% endfor %}
  </div>
  {% endif %}
  <div class="page-folio"></div>
</div>

{# --- PREP-AHEAD (own page) --- #}
{% if prep_ahead %}
<div class="page page-grocery">
  <div class="page-header">Kitchen & Pantry</div>
  <h2 class="section-header">Prep-Ahead Checklist</h2>
  <div class="prep-list">
    <ul>{% for task in prep_ahead %}<li>{{ task }}</li>{% endfor %}</ul>
  </div>
  <div class="page-folio"></div>
</div>
{% endif %}

{# --- SECTION DIVIDER: Family Corner --- #}
{% if parenting_data %}
<div class="page page-divider">
  <div class="divider-title">Family Corner</div>
  <div class="divider-rule"></div>
  <div class="divider-sub">Conversation starters, parenting nudges, and connection ideas</div>
</div>
{% endif %}

{# --- PARENTING CORNER (2-page spread) --- #}
{% if parenting_data %}
{# Page 1: Theme + Dinner Questions #}
<div class="page page-parenting">
  <div class="page-header">Family Corner</div>
  <h2 class="section-header">Parenting Corner</h2>
  {% if parenting_data.weekly_theme %}
  <div class="theme-banner">
    <h3>{{ parenting_data.weekly_theme.title }}</h3>
    <p>{{ parenting_data.weekly_theme.description }}</p>
  </div>
  {% endif %}

  {% if parenting_data.dinner_questions %}
  <h3 style="font-size:9.5pt;font-weight:600;margin:5pt 0 3pt;">Dinner Conversation Starters</h3>
  {% for q in parenting_data.dinner_questions %}
  <div class="question-entry">
    <div class="question-day">{{ q.day }} — {{ q.dinner | default("") }}</div>
    <div class="question-text">"{{ q.question }}"</div>
    <div class="question-why">{{ q.why }}</div>
  </div>
  {% endfor %}
  {% endif %}
  <div class="page-folio"></div>
</div>

{# Page 2: Nudges + Book Rec + Reflection #}
<div class="page page-parenting">
  <div class="page-header">Family Corner</div>
  <h2 class="section-header">Nudges & Reflection</h2>
  {% if parenting_data.nudges %}
  {% for n in parenting_data.nudges %}
  <div class="nudge-card">
    <h4>{{ n.title }}</h4>
    <p><em>{{ n.context }}</em></p>
    <p>{{ n.suggestion }}</p>
    {% if n.how_to %}
    <ol class="nudge-steps">{% for step in n.how_to %}<li>{{ step }}</li>{% endfor %}</ol>
    {% endif %}
  </div>
  {% endfor %}
  {% endif %}

  {% if parenting_data.recommendation %}
  <div class="book-rec">
    <h4>📖 {{ parenting_data.recommendation.title }}{% if parenting_data.recommendation.author %} by {{ parenting_data.recommendation.author }}{% endif %}</h4>
    <p>{{ parenting_data.recommendation.why }}</p>
    <p><em>{{ parenting_data.recommendation.connection }}</em></p>
  </div>
  {% endif %}

  {% if parenting_data.parent_reflection %}
  <div class="reflection-box">
    {{ parenting_data.parent_reflection }}
  </div>
  {% endif %}

  <p style="font-size:6.5pt;color:#aaa;text-align:center;margin-top:6pt;font-style:italic;">You don't need to be a perfect parent — just a present one.</p>
  <div class="page-folio"></div>
</div>
{% endif %}

{# --- EXTRA SECTIONS (extensible, non-parenting) --- #}
{% if extra_sections %}
{% for section in extra_sections %}
{% if "Parenting" not in section.title %}
<div class="page page-extra">
  <div class="page-header">Extras</div>
  <h2 class="section-header">{{ section.title }}</h2>
  <div class="extra-content">{{ section.content }}</div>
  <div class="page-folio"></div>
</div>
{% endif %}
{% endfor %}
{% endif %}

{# --- BACK COVER --- #}
<div class="page page-back">
  <div class="back-inner">
  {% if notes %}
  <div class="notes-section">
    <h3>Notes</h3>
    <ul>{% for note in notes %}<li>{{ note }}</li>{% endfor %}</ul>
  </div>
  {% endif %}
  {% if nutrition_summary %}
  <div class="nutrition"><strong>Nutrition at a Glance</strong>{{ nutrition_summary }}</div>
  {% endif %}
  <div class="back-divider"></div>
  <div class="colophon">{{ week_range }} · Generated {{ generated_at }}</div>
  </div>
</div>


{# ============================================
   SCREEN LAYOUT — Mobile HTML (all inline)
   ============================================ #}

<div class="screen-container">
  <div class="cover-screen">
    <h1>Weekly Planner</h1>
    <div class="week-range">{{ week_range }}</div>
    {% if highlight %}
    <div class="highlight">{{ highlight }}</div>
    {% endif %}
  </div>

  <h2 class="section-title">Week at a Glance</h2>
  <table class="glance-table">
    <thead>
      <tr><th></th><th>Day</th><th>Weather</th><th>Events</th><th>Dinner</th><th>Album</th></tr>
    </thead>
    <tbody>
      {% for day in days %}
      <tr>
        <td><span class="weather-emoji">{{ weather_icon(day.weather) }}</span></td>
        <td class="day-name">{{ day.name }}</td>
        <td>{{ day.weather | default("—") }}</td>
        <td>{% if day.calendar_items %}{% for item in day.calendar_items %}{{ item }}{% if not loop.last %}; {% endif %}{% endfor %}{% else %}—{% endif %}</td>
        <td>{{ day.dinner | default("—") }}</td>
        <td>{{ day.album | default("—") }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <h2 class="section-title">Daily Plan</h2>
  {% for day in days %}
  <div class="day-card">
    <h3>{{ day.long_name }}</h3>
    {% if day.day_intro %}<p style="font-style:italic;color:var(--muted);font-size:14px;margin-bottom:10px;">{{ day.day_intro }}</p>{% endif %}
    {% if day.weather %}<div class="weather"><span class="weather-emoji">{{ weather_icon(day.weather) }}</span> {{ day.weather }}{% if day.weather_detail %} · {{ day.weather_detail }}{% endif %}</div>{% endif %}

    {% if day.calendar_items %}
    <div style="margin-bottom:10px;">
      {% for item in day.calendar_items %}<div style="font-size:13px;">📅 {{ item }}</div>{% endfor %}
    </div>
    {% endif %}

    {% if day.dinner %}
    <div class="dinner-title">{{ day.dinner }}</div>
    {% if day.dinner_cuisine %}<span class="cuisine-tag">{{ day.dinner_cuisine }}</span>{% endif %}
    {% if day.dinner_description %}<p class="description">{{ day.dinner_description }}</p>{% endif %}
    {% if day.dinner_key_ingredients %}<p class="ingredients">{{ day.dinner_key_ingredients | join(", ") }}</p>{% endif %}
    {% if day.dinner_source_url %}<a href="{{ day.dinner_source_url }}" target="_blank" rel="noopener" class="recipe-link">📖 Recipe: {{ day.dinner_source_name | default("View recipe") }}</a>{% endif %}
    {% if day.dinner_notes %}<p class="notes">{{ day.dinner_notes }}</p>{% endif %}
    {% endif %}

    {% if day.dinner_elevation_tips %}
    <div class="elevation-tips">
      <h4>🔥 Chef's Tips</h4>
      {% for tip in day.dinner_elevation_tips %}
      <div class="elevation-tip">
        <span class="tip-label">{{ tip.type }}:</span> <strong>{{ tip.title }}</strong> — {{ tip.instruction }}
      </div>
      {% endfor %}
    </div>
    {% endif %}

    {% if day.prep_detail %}
    <details class="prep-detail">
      <summary>🍳 Full Prep Instructions</summary>
      <div class="prep-meta">
        {% if day.prep_detail.prep_timeline %}<span class="prep-meta-item">⏱ {{ day.prep_detail.prep_timeline }}</span>{% endif %}
        {% if day.prep_detail.active_time %}<span class="prep-meta-item">👩‍🍳 Active: {{ day.prep_detail.active_time }}</span>{% endif %}
      </div>
      {% if day.prep_detail.prep_steps %}
      <ol class="prep-steps">
        {% for step in day.prep_detail.prep_steps %}<li>{{ step }}</li>{% endfor %}
      </ol>
      {% endif %}
      {% if day.prep_detail.special_equipment %}
      <div class="prep-equipment">🔧 <strong>Equipment:</strong> {{ day.prep_detail.special_equipment | join(", ") }}</div>
      {% endif %}
      {% if day.prep_detail.make_ahead %}
      <div class="prep-make-ahead">💡 <strong>Make ahead:</strong> {{ day.prep_detail.make_ahead }}</div>
      {% endif %}
    </details>
    {% endif %}

    {% if day.album %}
    <div class="album-pairing">
      <div class="album-name">🎵 {{ day.album }}</div>
      <div class="album-meta">{{ day.album_year | default("") }} · {{ day.album_genre | default("") }}</div>
      {% if day.album_description %}<div class="album-desc">{{ day.album_description }}</div>{% endif %}
      {% if day.album_sonic_description %}<div class="album-sonic">🔊 {{ day.album_sonic_description }}</div>{% endif %}
      {% if day.album_pairing_rationale %}<div class="album-rationale">{{ day.album_pairing_rationale }}</div>{% endif %}
      {% if day.album_spotify_url %}<a href="{{ day.album_spotify_url }}" target="_blank" rel="noopener" class="spotify-link">🎧 Listen on Spotify</a>{% endif %}
    </div>
    {% endif %}

    {% if day.prep_notes %}
    <div class="prep-notes">
      <h4>Prep Notes</h4>
      <ul>{% for note in day.prep_notes %}<li>{{ note }}</li>{% endfor %}</ul>
    </div>
    {% endif %}
  </div>
  {% endfor %}

  {% if appetizers %}
  <h2 class="section-title">Appetizers</h2>
  {% for a in appetizers %}
  <div class="appetizer-card">
    <h4>{{ a.name }}</h4>
    {% if a.cuisine %}<span class="cuisine-tag" style="margin-bottom:6px;">{{ a.cuisine }}</span>{% endif %}
    <p>{{ a.description | default("") }}</p>
    {% if a.key_ingredients %}<p style="font-size:13px;color:var(--muted);">{{ a.key_ingredients | join(", ") }}</p>{% endif %}
    {% if a.source_url %}<a href="{{ a.source_url }}" target="_blank" rel="noopener" class="recipe-link">📖 {{ a.source_name | default("View recipe") }}</a>{% endif %}
  </div>
  {% endfor %}
  {% endif %}

  {% if salads %}
  <h2 class="section-title">Salads</h2>
  {% for s in salads %}
  <div class="salad-card">
    <div class="salad-type">{{ s.salad_type | default("side") | replace("_", " ") }}</div>
    <h4>{{ s.name }}</h4>
    <p>{{ s.description | default("") }}</p>
    {% if s.key_ingredients %}<p style="font-size:13px;color:var(--muted);">{{ s.key_ingredients | join(", ") }}</p>{% endif %}
    {% if s.dressing %}<div class="dressing"><strong>Dressing:</strong> {{ s.dressing }}</div>{% endif %}
    {% if s.flavor_rationale %}<div class="rationale">{{ s.flavor_rationale }}</div>{% endif %}
    {% if s.source_url %}<a href="{{ s.source_url }}" target="_blank" rel="noopener" class="recipe-link">📖 {{ s.source_name | default("View recipe") }}</a>{% endif %}
  </div>
  {% endfor %}
  {% endif %}

  {% if beverages %}
  <h2 class="section-title">Beverages</h2>
  {% for b in beverages %}
  <div class="beverage-card">
    <h4>{{ b.name }}</h4>
    <p>{{ b.description | default("") }}</p>
    {% if b.why %}<p style="font-size:13px;font-style:italic;color:var(--muted);">{{ b.why }}</p>{% endif %}
  </div>
  {% endfor %}
  {% endif %}

  <h2 class="section-title">Grocery List</h2>
  {% if grocery_list %}
  <div class="grocery-section">
    {% for category, items in grocery_list.items() %}
    <div class="grocery-category">
      <h4>{{ category }}</h4>
      <ul>{% for item in items %}<li>{{ item }}</li>{% endfor %}</ul>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {% if prep_ahead %}
  <h2 class="section-title">Prep-Ahead Checklist</h2>
  <ul class="prep-checklist">
    {% for task in prep_ahead %}<li>{{ task }}</li>{% endfor %}
  </ul>
  {% endif %}

  {% if parenting_data %}
  <h2 class="section-title">Parenting Corner</h2>
  <div class="parenting-section">
    {% if parenting_data.weekly_theme %}
    <div class="theme-banner">
      <h3>{{ parenting_data.weekly_theme.title }}</h3>
      <p>{{ parenting_data.weekly_theme.description }}</p>
    </div>
    {% endif %}

    {% if parenting_data.dinner_questions %}
    <h4 style="font-size:15px;font-weight:600;margin-bottom:8px;">Dinner Conversation Starters</h4>
    {% for q in parenting_data.dinner_questions %}
    <div class="question-card">
      <div class="question-day">{{ q.day }} — {{ q.dinner | default("") }}</div>
      <div class="question-text">"{{ q.question }}"</div>
      <div class="question-why">{{ q.why }}</div>
    </div>
    {% endfor %}
    {% endif %}

    {% if parenting_data.nudges %}
    <h4 style="font-size:15px;font-weight:600;margin:16px 0 8px;">Parenting Nudges</h4>
    {% for n in parenting_data.nudges %}
    <div class="nudge-card">
      <h4>{{ n.title }}</h4>
      <p style="font-style:italic;">{{ n.context }}</p>
      <p>{{ n.suggestion }}</p>
      {% if n.how_to %}
      <ol class="nudge-steps">{% for step in n.how_to %}<li>{{ step }}</li>{% endfor %}</ol>
      {% endif %}
    </div>
    {% endfor %}
    {% endif %}

    {% if parenting_data.recommendation %}
    <div class="book-rec">
      <div class="book-icon">📖</div>
      <div class="book-info">
        <h4>{{ parenting_data.recommendation.title }}{% if parenting_data.recommendation.author %} by {{ parenting_data.recommendation.author }}{% endif %}</h4>
        <p>{{ parenting_data.recommendation.why }}</p>
        <p style="font-style:italic;">{{ parenting_data.recommendation.connection }}</p>
      </div>
    </div>
    {% endif %}

    {% if parenting_data.parent_reflection %}
    <div class="reflection-box">
      {{ parenting_data.parent_reflection }}
    </div>
    {% endif %}
  </div>
  {% endif %}

  {% if extra_sections %}
  {% for section in extra_sections %}
  {% if "Parenting" not in section.title %}
  <div class="extra-section">
    <h3>{{ section.title }}</h3>
    <div>{{ section.content }}</div>
  </div>
  {% endif %}
  {% endfor %}
  {% endif %}

  {% if notes %}
  <h2 class="section-title">Notes</h2>
  <div class="support-section">
    <ul>{% for note in notes %}<li>{{ note }}</li>{% endfor %}</ul>
  </div>
  {% endif %}

  {% if nutrition_summary %}
  <h2 class="section-title">Nutrition</h2>
  <div class="support-section"><p>{{ nutrition_summary }}</p></div>
  {% endif %}

  <div class="footer">{{ week_range }} · Generated {{ generated_at }}</div>
</div>

</body>
</html>
